# ---- Frontend (Vite, must be VITE_ prefixed) ----
VITE_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
VITE_MONAD_CHAIN_ID=10143
# Address printed by the DeployClutch script
VITE_CLUTCH_ADDRESS=

# ---- Contracts (Foundry) ----
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
# Deployer = Clutch owner = the only account that can open and resolve markets
PRIVATE_KEY=

# ---- Sponsor drip (api/fund.ts) ----
# Funds each burner wallet so the room can trade without a faucet or MetaMask.
# Use a DIFFERENT key from PRIVATE_KEY so a drained sponsor cannot block resolution.
SPONSOR_PRIVATE_KEY=
FUND_AMOUNT_MON=0.2
FUND_MAX_WALLETS=250

# Optional
# MONADSCAN_API_KEY=
